  "origins.neoorigins.wraith.name": "Wraith",
  "origins.neoorigins.wraith.description": "Një shpirt i munduar që përshkon nëpër lëndë të ngurtë. Kalon nëpër shumicën e blloqeve, por nuk mund të kalojë obsidianin derisa të arrijë formën e tij kulmore. Mbajtja e një forme fizike e largon urinë dhe rrezet e diellit gërryen mishin e saj spektral.",
  "power.neoorigins.wraith_phase.name": "Forma spektrale",
  "power.neoorigins.wraith_phase.description": "Ndrysho: ecni nëpër blloqe të forta. Ndërsa jeni brenda një blloku, fluturoni lirshëm (kërcim = lart, zhvendosje = poshtë). Obsidiani, obsidiani që qan dhe guri themelor bllokojnë kalimin tuaj. Fazizimi e kullon urinë.",
  "power.neoorigins.wraith_water_breathing.name": "Pa frymë",
  "power.neoorigins.wraith_water_breathing.description": "Nuk ka nevojë të marrë frymë. Mund të mbijetojë për një kohë të pacaktuar nën ujë.",
  "power.neoorigins.wraith_daylight_damage.name": "Ndjeshmëria ndaj dritës së diellit",
  "power.neoorigins.wraith_daylight_damage.description": "Ju digjen në rrezet e diellit direkte.",
  "power.neoorigins.wraith_hunger_drain.name": "Forma e paqëndrueshme"
}
