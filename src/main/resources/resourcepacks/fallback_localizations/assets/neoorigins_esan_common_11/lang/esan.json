  "origins.neoorigins.wraith.name": "Espectro",
  "origins.neoorigins.wraith.description": "Un espíritu atormentado que çe desplaza a trabêh de la materia sólida. Atrabieça la mayoría de lô bloquê, pero no pué paçâh la ôççidiana. Mantenêh una forma física agota er ambre, y la lûh solar abrasa su carne êppêttrâh.",
  "power.neoorigins.wraith_phase.name": "Forma Êppêttrâh",
  "power.neoorigins.wraith_phase.description": "Alternable: camina a trabêh de bloquê sólidos. Dentro de un bloque, vuela libremente (çartâh = arriba, agaxarçe = abaho). La ôççidiana, la ôççidiana lacrimoça y la roca madre bloquean tu paço. Atravesar bloquê agota er ambre.",
  "power.neoorigins.wraith_water_breathing.name": "Çin aliento",
  "power.neoorigins.wraith_water_breathing.description": "No neçeçita respirar y pué sobrevivir indefinidamente baho er agua.",
  "power.neoorigins.wraith_daylight_damage.name": "Çençibilidá a la Lûh Solar",
  "power.neoorigins.wraith_daylight_damage.description": "Ardes baho la lûh solar dirêtta.",
  "power.neoorigins.wraith_hunger_drain.name": "Forma Inestable"
