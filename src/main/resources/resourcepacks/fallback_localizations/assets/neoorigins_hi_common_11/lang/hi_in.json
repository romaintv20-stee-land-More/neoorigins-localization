  "origins.neoorigins.wraith.name": "रेथ",
  "origins.neoorigins.wraith.description": "एक पीड़ित आत्मा जो ठोस पदार्थ के माध्यम से बहती है।अधिकांश ब्लॉकों से होकर गुजरता है लेकिन ओब्सीडियन से तब तक नहीं गुजर सकता जब तक यह अपने शीर्ष रूप तक नहीं पहुंच जाता।भौतिक रूप बनाए रखने से भूख खत्म हो जाती है, और सूरज की रोशनी उसके वर्णक्रमीय मांस को नष्ट कर देती है।",
  "power.neoorigins.wraith_phase.name": "वर्णक्रमीय रूप",
  "power.neoorigins.wraith_phase.description": "टॉगल करें: ठोस ब्लॉकों के माध्यम से चलें।एक ब्लॉक के अंदर रहते हुए, स्वतंत्र रूप से उड़ें (कूदें = ऊपर, शिफ्ट = नीचे)।ओब्सीडियन, रोता हुआ ओब्सीडियन और आधारशिला आपके मार्ग को अवरुद्ध करते हैं।चरणबद्ध तरीके से भूख मिटती है।",
  "power.neoorigins.wraith_water_breathing.name": "बेदम",
  "power.neoorigins.wraith_water_breathing.description": "सांस लेने की जरूरत नहीं है.पानी के अंदर अनिश्चित काल तक जीवित रह सकता है।",
  "power.neoorigins.wraith_daylight_damage.name": "सूर्य के प्रकाश की संवेदनशीलता",
  "power.neoorigins.wraith_daylight_damage.description": "आप सीधी धूप में जलते हैं।",
  "power.neoorigins.wraith_hunger_drain.name": "अस्थिर रूप"
}
