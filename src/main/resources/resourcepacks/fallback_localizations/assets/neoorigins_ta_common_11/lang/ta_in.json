  "origins.neoorigins.wraith.name": "வ்ரைத்",
  "origins.neoorigins.wraith.description": "திடமான பொருளின் வழியாகச் செல்லும் ஒரு வேதனையான ஆவி. பெரும்பாலான தொகுதிகள் வழியாக கட்டங்கள் ஆனால் அதன் உச்ச வடிவத்தை அடையும் வரை அப்சிடியனை கடக்க முடியாது. ஒரு உடல் வடிவத்தை நிலைநிறுத்துவது பசியை வெளியேற்றுகிறது, மேலும் சூரிய ஒளி அதன் நிறமாலை சதையை உறிஞ்சுகிறது.",
  "power.neoorigins.wraith_phase.name": "நிறமாலை வடிவம்",
  "power.neoorigins.wraith_phase.description": "மாற்று: திடமான தொகுதிகள் வழியாக நடக்கவும். ஒரு தொகுதிக்குள் இருக்கும்போது, ​​சுதந்திரமாக பறக்கவும் (குதி = மேலே, ஷிப்ட் = கீழே). அப்சிடியன், அழுகை அப்சிடியன் மற்றும் அடிப்பாறை உங்கள் பாதையைத் தடுக்கிறது. படிப்படியாக பசியை வெளியேற்றுகிறது.",
  "power.neoorigins.wraith_water_breathing.name": "மூச்சுத்திணறல்",
  "power.neoorigins.wraith_water_breathing.description": "சுவாசிக்க தேவையில்லை. நீருக்கடியில் காலவரையின்றி வாழ முடியும்.",
  "power.neoorigins.wraith_daylight_damage.name": "சூரிய ஒளி உணர்திறன்",
  "power.neoorigins.wraith_daylight_damage.description": "நீங்கள் நேரடி சூரிய ஒளியில் எரிக்கிறீர்கள்.",
  "power.neoorigins.wraith_hunger_drain.name": "நிலையற்ற படிவம்"
}
