  "origins.neoorigins.human.name": "İnsan",
  "origins.neoorigins.human.description": "Özel güçleri olmayan, ancak dengeli yeteneklere sahip sıradan bir insan.",
  "origins.neoorigins.merling.name": "Merling",
  "origins.neoorigins.merling.description": "Açık okyanusta doğmuş su halkı — suda nefes alır ve rahatça yüzer; ancak karada yavaştır ve kurur.",
  "origins.neoorigins.avian.name": "Avian",
  "origins.neoorigins.avian.description": "Yavaşça aşağı süzülen, yükseklikten korkmayan ve dünyayı yukarıdan izleyen zarif bir uçucu.",
  "origins.neoorigins.blazeling.name": "Blazeling",
  "origins.neoorigins.blazeling.description": "Nether ateşlerinden doğmuş — kükürtle kaplı, karanlık diyarda yenilenen; fakat su ve yağmurdan zehirlenen bir varlık.",
  "origins.neoorigins.elytrian.name": "Elytrian",
  "origins.neoorigins.elytrian.description": "Tam bir uçuş uzmanı — göklerde süzülür, kinetik kuvvetlerden etkilenmez; ancak bedeni kırılgandır ve ağır zırh taşıyamaz.",
  "origins.neoorigins.enderian.name": "Enderian",
  "origins.neoorigins.enderian.description": "End'in dış adalarında doğmuş — istediği zaman ışınlanır, mermilerden boşluğa sıçrayarak kaçar ve endermanlar tarafından fark edilmeden yürür. Su asit gibi yakar.",
  "origins.neoorigins.arachnid.name": "Arachnid",
  "origins.neoorigins.arachnid.description": "Her duvara tırmanan, düşmanlarına ağ fırlatan ve dişleriyle saldıran çevik örümcek halkı — dünyanın sekiz bacaklı yaratıklarıyla akrabadır.",
  "origins.neoorigins.shulk.name": "Shulk",
  "origins.neoorigins.shulk.description": "Bir shulker gibi zırhlı — darbeleri umursamaz, köşeye sıkışınca kabuğuna çekilir ve havaya yükseltme patlamasıyla düşmanları göğe fırlatır. Yavaştır ama sarsılmazdır.",
  "origins.neoorigins.phantom.name": "Phantom",
  "origins.neoorigins.phantom.description": "Hayaletimsi bir varlık — gece elytra kanatlarıyla süzülür ve öldürdüklerinden güç kazanır; ancak güneş ışığında yanar ve dinlenemez.",
  "power.neoorigins.merling_water_breathing.name": "Solungaçlar",
  "power.neoorigins.merling_water_breathing.description": "Suyun altında süresiz nefes alır ve sis olmadan suyun içini net biçimde görür.",
  "power.neoorigins.merling_aquatic_speed.name": "Su Hızı",
  "power.neoorigins.merling_aquatic_speed.description": "Yüzerken daha hızlı hareket eder.",
  "power.neoorigins.merling_night_vision.name": "Derin Görüş",
  "power.neoorigins.merling_night_vision.description": "Karanlık derinliklerde net görür. Gece Görüşü tuşuyla açıp kapat (varsayılan K).",
  "power.neoorigins.merling_land_slowdown.name": "Karacı",
  "power.neoorigins.merling_land_slowdown.description": "Karada %10 daha yavaş hareket eder.",
  "power.neoorigins.merling_dries_out.name": "Kuruma",
  "power.neoorigins.merling_dries_out.description": "Sudan çıktığında hava sayacın azalır: çok uzun süre yüzeyde kalırsan boğulursun. Yağmur, su dolu kazan, Suda Nefes Alma veya yakındaki etkin bir conduit bunu engeller.",
  "power.neoorigins.avian_no_fall_damage.name": "Tüy Kadar Hafif",
  "power.neoorigins.avian_no_fall_damage.description": "Düşme hasarı almaz — kanatların rüzgârı yakalar.",
  "power.neoorigins.avian_slow_fall.name": "Yavaş Düşüş",
  "power.neoorigins.avian_slow_fall.description": "Açılıp kapatılabilir: yavaşça aşağı süzülür. Varsayılan olarak kapalıdır. Not: kritik vuruşlar normal şekilde düşmeyi gerektirir, bu yüzden kritik vurmak için bunu kapalı tut.",
  "power.neoorigins.avian_no_hunger_sprint.name": "Sporcu Diyeti",
  "power.neoorigins.avian_no_hunger_sprint.description": "Tüm eylemlerde %75 daha az enerji harcar.",
  "power.neoorigins.avian_keen_sight.name": "Keskin Görüş"
}
