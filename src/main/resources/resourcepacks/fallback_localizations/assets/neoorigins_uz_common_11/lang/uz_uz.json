  "origins.neoorigins.wraith.name": "Ruhoniy",
  "origins.neoorigins.wraith.description": "Qattiq materiyadan o'tib ketadigan azobli ruh.Ko'pgina bloklardan o'tadi, lekin obsidian o'zining cho'qqi shakliga etmaguncha o'tolmaydi.Jismoniy shaklni saqlab qolish ochlikni yo'qotadi va quyosh nuri uning spektral go'shtini yirtadi.",
  "power.neoorigins.wraith_phase.name": "Spektral shakl",
  "power.neoorigins.wraith_phase.description": "Oʻzgartirish: qattiq bloklar boʻylab yurish.Blok ichida bo'lganingizda erkin uching (sakrash = yuqoriga, siljish = pastga).Obsidian, yig'layotgan obsidian va tog' jinslari sizning o'tishingizni to'sib qo'yadi.Bosqichma-bosqich ochlikni yo'qotadi.",
  "power.neoorigins.wraith_water_breathing.name": "Nafassiz",
  "power.neoorigins.wraith_water_breathing.description": "Nafas olish kerak emas.Suv ostida cheksiz yashay oladi.",
  "power.neoorigins.wraith_daylight_damage.name": "Quyosh nuriga sezgirlik",
  "power.neoorigins.wraith_daylight_damage.description": "Siz to'g'ridan-to'g'ri quyosh nurida yonasiz.",
  "power.neoorigins.wraith_hunger_drain.name": "Barqaror shakl"
